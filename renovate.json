{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mozilla-releng/reps:renovate-preset.json5"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "managerFilePatterns": ["taskcluster/docker/node/Dockerfile"],
      "matchStrings": [
        "npm install -g (?<depName>\\S+?)@(?<currentValue>[^\\s\\\\]+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["template/.taskcluster.yml.tmpl"],
      "matchStrings": [
        "image: (?<depName>\\S+):(?<currentValue>decision-\\S+)@(?<currentDigest>\\S+)"
      ],
      "versioningTemplate": "regex:^decision-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["template/**"],
      "semanticCommitType": "fix"
    }
  ]
}
